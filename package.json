{
  "name": "nexusboard",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "verify": "yarn verify:work-management-service && yarn verify:web",
    "verify:work-management-service": "yarn workspace @nexusboard/work-management-service run verify",
    "verify:web": "yarn workspace @nexusboard/web run verify",
    "dev:web": "yarn workspace @nexusboard/web run dev",
    "dev:work-management-service": "yarn workspace @nexusboard/work-management-service run start:dev"
  }
}
